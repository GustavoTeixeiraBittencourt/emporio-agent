# Any OpenAI-compatible chat-completions endpoint works.
#
# Default: Google Gemini (free tier) via its OpenAI-compatible endpoint.
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# --- Alternative: OpenAI ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Alternative: local Ollama (no API key needed, use any placeholder) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Optional: freeze the agent's clock for demos/tests (ISO 8601, America/Campo_Grande).
# AGENT_NOW=2026-03-23T10:30:00
